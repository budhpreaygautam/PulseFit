# Node
node_modules/

# Build output
dist/
dist-mobile/
build/
# API address the app bundle was last built against (scripts/mobile-sync.mjs)
client/.mobile-api-url

# Environment / secrets
.env
.env.*
!.env.example

# Optional local HTTPS certificates for the Vite dev server (see README)
client/certs/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Runtime database (created and seeded on first start; `npm run seed` resets it)
server/data/*.json
server/data/*.tmp
server/data/*.corrupt-*
# Development JWT secret generated when JWT_SECRET is unset (server/src/config.ts)
server/data/.dev-jwt-secret

# Test & tooling output
coverage/
playwright-report/
test-results/
