# PulseFit API configuration. Copy to server/.env and fill in what you need.
# Everything is optional for local development: the API starts with demo data,
# demo personas on, and online payments / Google sign-in switched off.

# development | production | test. When unset, `npm run dev` is development and `npm start`
# (the compiled build in dist/) is production, so a deploy cannot accidentally run with
# development shortcuts.
# NODE_ENV=production

# Port the API listens on (the Vite dev server proxies /api here).
PORT=5004

# Network address the API listens on. Default: 127.0.0.1 in development (this machine only, so
# nobody on the Wi-Fi can use the demo admin), every interface elsewhere. Set HOST=0.0.0.0 only
# when a phone or another computer on the LAN must reach a development API.
# HOST=0.0.0.0

# Secret used to sign login tokens. REQUIRED in production: 32+ random characters,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development, when unset, a random secret is generated once and kept in server/data/.dev-jwt-secret
# (next to the database, git-ignored) so sessions survive restarts.
JWT_SECRET=

# 1-click demo personas (member / VIP / trainer / admin) on the sign-in screen.
# Defaults to on in local development and off everywhere else. They hand out admin access,
# and the demo accounts use the published password pulse123, so only turn this on for a
# public demo that holds no real data. Without it, a fresh database gets the catalogue only
# and the first admin is created with `npm run create-admin`.
# DEMO_MODE=true

# Number of reverse proxies in front of the API (1 on Render, Railway, Fly or behind nginx).
# Needed for per-IP rate limits to see the real client; leave unset when nothing is in front.
# Production warns at startup when it looks like a proxy is in front but this is unset.
# TRUST_PROXY=1

# Rate limits on sign-in, password reset and the whole API (per IP and per account). On by
# default; production warns at startup when they are off.
# RATE_LIMIT=true

# Browser origins allowed to call the API (comma-separated). Unset: the Vite dev server
# (http://localhost:5173) in local development, PUBLIC_URL everywhere else; production never falls
# back to localhost, and warns at startup when both are unset.
CLIENT_ORIGIN=http://localhost:5173,https://localhost:5173

# Origins of the Android and iOS apps (Capacitor), also allowed to call the API.
# Default: https://localhost (Android) and capacitor://localhost (iOS). Set it empty to refuse the apps.
# APP_ORIGINS=https://localhost,capacitor://localhost

# The address people open the app at, with https:// and without a trailing slash. Password
# reset links, canonical links, sitemap.xml and the HTTPS redirect are built on it. Set it in
# production: without it they use the first CLIENT_ORIGIN (production never trusts the request's
# Host / X-Forwarded-Host headers).
# PUBLIC_URL=https://gym.example.com

# Let search engines index the website (robots.txt opens the public pages and names /sitemap.xml).
# Default: on in production, off elsewhere. Set it to false on staging and preview deploys:
# robots.txt then answers "Disallow: /", /sitemap.xml is not served, and every response carries
# X-Robots-Tag: noindex.
# ALLOW_INDEXING=false

# In production with an https:// PUBLIC_URL, answer plain-HTTP requests with a 301 to the same path
# on PUBLIC_URL (/api/health excepted, for load balancers). Needs TRUST_PROXY, and a proxy that sends
# X-Forwarded-Proto (Cloudflare, Render, Railway, Fly and Heroku do; nginx needs
# `proxy_set_header X-Forwarded-Proto $scheme;`). Default: on. Turn it off when the proxy redirects.
# HTTPS_REDIRECT=false

# Strict-Transport-Security: browsers use HTTPS only for this host and its sub-domains for a year.
# Default: on, except in local development. Every sub-domain must serve HTTPS once it is on.
# HSTS=false

# There is no email delivery, so a password reset link only reaches people when staff copy it from
# the server log. Off by default in production (the log would hold working links; staff set a
# temporary password from the members screen instead); on in local development, where the link is
# also returned in the API response. The log line names the account id, never the email.
# LOG_RESET_LINKS=true

# Gym timezone for "today", class times and analytics.
GYM_TIMEZONE=Asia/Kolkata

# Refuse check-ins, floor clock-ins and same-day free trials while the gym is closed
# (Mon-Sat 06:00-22:00 gym time). On by default; the test suites switch it off.
# ENFORCE_OPENING_HOURS=true

# Razorpay (https://dashboard.razorpay.com/app/keys). Leave empty to disable checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for POST /api/payment/webhook (Razorpay dashboard -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# YouPI PG: free, self-hosted UPI to your own bank account (https://github.com/youpi-pg/YouPI-PG).
# EXPERIMENTAL: YouPI confirms payments by reading your bank's SMS/email alerts; read README › Payments
# before taking real money. Leave empty to disable.
# The Payment API address: https:// in production (or http://localhost on the same machine).
YOUPI_API_URL=
# Your merchant id in the YouPI Merchant Admin.
YOUPI_MERCHANT_ID=
# That merchant's webhook secret. Also authenticates payment-status lookups. Set YouPI's webhook URL
# to https://<your-domain>/api/payment/youpi/webhook.
YOUPI_WEBHOOK_SECRET=
# Which gateway new checkouts use: razorpay or youpi. Empty: Razorpay when its keys are set, else YouPI.
PAYMENT_PROVIDER=

# Google sign-in: an OAuth 2.0 Web client id from Google Cloud Console
# (APIs & Services -> Credentials). Add http://localhost:5173 as an authorised JavaScript origin.
# Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=

# Where the JSON database lives (default: server/data/gym-db.json).
# PULSEFIT_DB_PATH=

# Serve the built client (client/dist) from the API, with each page's title, description,
# canonical link and JSON-LD filled into index.html, plus /robots.txt and /sitemap.xml.
# Defaults to on in production.
# SERVE_CLIENT=true
