{
  "name": "pulsefit-client",
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mobile:sync": "node scripts/mobile-sync.mjs",
    "mobile:run": "node scripts/android-run.mjs",
    "mobile:release": "node scripts/android-release.mjs",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "check:art": "node scripts/check-app-art.mjs",
    "gift:add": "node scripts/add-gift-pictures.mjs",
    "test:art": "node --test scripts/check-app-art.test.mjs scripts/add-gift-pictures.test.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "canvas-confetti": "^1.9.4",
    "lottie-web": "5.13.0",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.3.8"
