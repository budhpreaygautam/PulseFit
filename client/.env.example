# The client needs no secrets: Razorpay's public key id, Google sign-in and demo mode are
# read at runtime from the API's GET /api/config.

# Where the Vite dev server forwards /api requests (default http://127.0.0.1:5004, the
# IPv4 loopback, so a localhost that resolves to ::1 first cannot miss the API).
# VITE_API_PROXY_TARGET=http://127.0.0.1:5004
